{
  "name": "poi-plugin-eqmod",
  "version": "0.2.0",
  "description": "Poi equipment improvement recipe viewer",
  "license": "MIT",
  "author": {
    "name": "zxvzxv",
    "url": "https://github.com/zxvzxv"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zxvzxv/poi-plugin-eqmod.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:update": "node scripts/fetch-wiki.mjs --proxy http://127.0.0.1:10808",
    "data:validate": "node scripts/validate-data.mjs src/data/improvements.json",
    "build": "npm run clean && tsc && node scripts/copy-assets.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm test && npm run data:validate && npm run build && npm run smoke"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@blueprintjs/core": ">=3 <6",
    "react": ">=16.8 <19",
    "react-dom": ">=16.8 <19",
    "react-redux": ">=7 <10"
  },
  "devDependencies": {
    "@blueprintjs/core": "^5.19.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-redux": "^7.1.34",
    "cheerio": "^1.0.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "typescript": "^5.7.2",
    "undici": "^7.16.0",
    "vitest": "^2.1.8"
  }
}
